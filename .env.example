# Token Bot Telegram dari @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ID Grup Telegram untuk reminder (otomatis terisi saat bot digunakan di grup, atau bisa diisi manual, misal: -1001234567890)
GROUP_ID=

# Harga per nomor untuk kalkulasi langganan (default: 125000)
PRICE_PER_NUMBER=125000

# Timezone (default: Asia/Jakarta untuk WIB)
TIMEZONE=Asia/Jakarta

